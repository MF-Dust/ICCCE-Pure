<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
                    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Indigo" SecondaryColor="Teal" />
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="MaterialSettingsSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsPageAnnotationForeground}" />
        <Setter Property="Margin" Value="2,18,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Keep the settings API, not its Fluent template. These state names and parts
         are used by SettingsCard's existing responsive layout and automation. -->
    <sys:Double x:Key="SettingsCardWrapThreshold">600</sys:Double>
    <sys:Double x:Key="SettingsCardWrapNoIconThreshold">420</sys:Double>
    <Storyboard x:Key="MaterialSettingsStackedContent">
        <Int32Animation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(Grid.Row)" To="1" Duration="0" />
        <Int32Animation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(Grid.Column)" To="1" Duration="0" />
        <Int32Animation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(Grid.ColumnSpan)" To="2" Duration="0" />
        <ThicknessAnimation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="Margin" To="0,12,0,0" Duration="0" />
        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="HorizontalAlignment">
            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static HorizontalAlignment.Stretch}" />
        </ObjectAnimationUsingKeyFrames>
    </Storyboard>
    <Style TargetType="ui:SettingsCard">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsPageForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsPageBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,14" />
        <Setter Property="MinHeight" Value="72" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingsCard">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <materialDesign:Card UniformCornerRadius="12" Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                         materialDesign:ElevationAssist.Elevation="Dp0">
                        <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="ContentAlignmentStates">
                                    <VisualState x:Name="Right" />
                                    <VisualState x:Name="RightWrapped" Storyboard="{StaticResource MaterialSettingsStackedContent}" />
                                    <VisualState x:Name="RightWrappedNoIcon" Storyboard="{StaticResource MaterialSettingsStackedContent}" />
                                    <VisualState x:Name="Vertical" Storyboard="{StaticResource MaterialSettingsStackedContent}" />
                                    <VisualState x:Name="Left">
                                        <Storyboard>
                                            <Int32Animation Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="(Grid.Column)" To="1" Duration="0" />
                                            <Int32Animation Storyboard.TargetName="HeaderStack" Storyboard.TargetProperty="(Grid.Column)" To="2" Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentHost" Storyboard.TargetProperty="HorizontalAlignment">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static HorizontalAlignment.Left}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid>
                            <Border x:Name="StateLayer" CornerRadius="12" IsHitTestVisible="False"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}" Opacity="0" />
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border x:Name="PART_HeaderIconPresenterHolder" Grid.Column="0"
                                        Width="36" Height="36" CornerRadius="10" Margin="0,0,12,0" VerticalAlignment="Center"
                                        Background="{DynamicResource SettingsContainerBackground}">
                                    <ContentPresenter Content="{TemplateBinding HeaderIcon}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </Border>
                                <StackPanel x:Name="HeaderStack" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <StackPanel.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </StackPanel.Resources>
                                    <ContentPresenter x:Name="PART_HeaderPresenter" Content="{TemplateBinding Header}"
                                                      TextElement.FontWeight="Medium" TextElement.FontSize="14" />
                                    <ContentPresenter x:Name="PART_DescriptionPresenter" Content="{TemplateBinding Description}"
                                                      Margin="0,4,0,0" TextElement.FontSize="12"
                                                      TextElement.Foreground="{DynamicResource SettingsPageAnnotationForeground}" />
                                </StackPanel>
                                <ContentPresenter x:Name="ContentHost" Grid.Column="2" Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <materialDesign:PackIcon x:Name="PART_ActionIconPresenterHolder" Grid.Column="3"
                                                         Kind="ChevronRight" Width="20" Height="20" Margin="12,0,0,0"
                                                         VerticalAlignment="Center" ToolTip="{TemplateBinding ActionIconToolTip}" />
                            </Grid>
                        </Grid>
                    </materialDesign:Card>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsClickEnabled" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.08" />
                            <Setter Property="Cursor" Value="Hand" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsClickEnabled" Value="True" />
                                <Condition Property="IsPressed" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="StateLayer" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ContentHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ui:SettingsExpander">
        <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource SettingsPageForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SettingsPageBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:SettingsExpander">
                    <ControlTemplate.Resources>
                        <DataTemplate DataType="{x:Type sys:String}">
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <materialDesign:Card UniformCornerRadius="12" Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                         materialDesign:ElevationAssist.Elevation="Dp0">
                        <Expander Style="{StaticResource MaterialDesignExpander}" HorizontalContentAlignment="Stretch"
                                  Background="Transparent" Foreground="{TemplateBinding Foreground}"
                                  IsExpanded="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Expander.Header>
                                <Grid Margin="8,8,12,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="ExpanderIcon" Content="{TemplateBinding HeaderIcon}"
                                                      Margin="0,0,16,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                        <StackPanel.Resources>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap" />
                                            </Style>
                                        </StackPanel.Resources>
                                        <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontSize="14" TextElement.FontWeight="Medium" />
                                        <ContentPresenter Content="{TemplateBinding Description}" TextElement.FontSize="12"
                                                          TextElement.Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                                    </StackPanel>
                                    <ContentPresenter Grid.Column="2" Content="{TemplateBinding Content}" VerticalAlignment="Center" />
                                </Grid>
                            </Expander.Header>
                            <StackPanel Margin="12,0,12,12">
                                <StackPanel.Resources>
                                    <Style TargetType="ui:SettingsCard" BasedOn="{StaticResource {x:Type ui:SettingsCard}}">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="Padding" Value="12" />
                                        <Setter Property="MinHeight" Value="60" />
                                    </Style>
                                </StackPanel.Resources>
                                <Border Height="1" Background="{DynamicResource SettingsPageBorderBrush}" Margin="4,0,4,4" />
                                <ContentPresenter Content="{TemplateBinding ItemsHeader}" />
                                <ui:ItemsRepeater x:Name="PART_ItemsRepeater" ItemTemplate="{TemplateBinding ItemTemplate}" />
                                <ContentPresenter Content="{TemplateBinding ItemsFooter}" />
                            </StackPanel>
                        </Expander>
                    </materialDesign:Card>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HeaderIcon" Value="{x:Null}">
                            <Setter TargetName="ExpanderIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.38" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- All switches share the Material template, including popups and expander rows. -->
    <Style x:Key="MaterialSettingsToggleSwitch" TargetType="ui:ToggleSwitch">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ToggleSwitch">
                    <StackPanel>
                        <ContentPresenter x:Name="SwitchHeader" Content="{TemplateBinding Header}" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                          IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding (AutomationProperties.Name), RelativeSource={RelativeSource TemplatedParent}}"
                                          VerticalAlignment="Center" />
                            <ContentPresenter x:Name="SwitchStateContent" Content="{TemplateBinding OffContent}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="SwitchStateContent" Property="Content" Value="{Binding OnContent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="SwitchHeader" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ui:ToggleSwitch" BasedOn="{StaticResource MaterialSettingsToggleSwitch}" />
    <Style TargetType="ui:ListView" BasedOn="{StaticResource MaterialDesignListBox}" />
    <Style TargetType="ui:ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}" />
    <Style TargetType="ui:ProgressBar">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:ProgressBar">
                    <ProgressBar Style="{StaticResource MaterialDesignLinearProgressBar}"
                                 Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                                 Value="{TemplateBinding Value}" IsIndeterminate="{TemplateBinding IsIndeterminate}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ui:HyperlinkButton">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:HyperlinkButton">
                    <materialDesign:Ripple Padding="{TemplateBinding Padding}"
                                           Feedback="{DynamicResource MaterialDesign.Brush.Primary}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </materialDesign:Ripple>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ui:InfoBar">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:InfoBar">
                    <materialDesign:Card x:Name="Banner" UniformCornerRadius="12" Padding="16"
                                         Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
                                         BorderBrush="{DynamicResource MaterialDesign.Brush.Primary}" BorderThickness="1"
                                         materialDesign:ElevationAssist.Elevation="Dp0">
                        <DockPanel>
                            <materialDesign:PackIcon Kind="InformationOutline" Width="24" Height="24" Margin="0,0,12,0"
                                                     VerticalAlignment="Top" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                            <ToggleButton x:Name="DismissButton" DockPanel.Dock="Right" VerticalAlignment="Top"
                                          Style="{StaticResource MaterialDesignFlatToggleButton}" Width="40" Height="40" Padding="8"
                                          IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          AutomationProperties.Name="{Binding Text, Source={x:Static SystemCommands.CloseWindowCommand}}">
                                <materialDesign:PackIcon Kind="Close" Width="20" Height="20" />
                            </ToggleButton>
                            <StackPanel>
                                <TextBlock x:Name="BannerTitle" Text="{TemplateBinding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                                <TextBlock Text="{TemplateBinding Message}" TextWrapping="Wrap" />
                                <ContentPresenter Content="{TemplateBinding Content}" />
                            </StackPanel>
                        </DockPanel>
                    </materialDesign:Card>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter TargetName="Banner" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="False">
                            <Setter TargetName="DismissButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Title" Value="">
                            <Setter TargetName="BannerTitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="8" />
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="8" />
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
        <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="20" />
    </Style>
    <DropShadowEffect x:Key="MaterialToolbarShadow" Color="#14141F" BlurRadius="12" ShadowDepth="2" Opacity="0.16" />
</ResourceDictionary>
