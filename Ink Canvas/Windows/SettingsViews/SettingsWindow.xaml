<Window xmlns:props="clr-namespace:Ink_Canvas.Properties"
    x:Class="Ink_Canvas.Windows.SettingsViews.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    Title="{x:Static props:NavStrings.Nav_SettingsWindow_Title}"
    Width="1138" Height="750" MinWidth="270" MinHeight="400"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource SettingsPageBackground}"
    Foreground="{DynamicResource SettingsPageForeground}"
    TextElement.Foreground="{DynamicResource SettingsPageForeground}"
    UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
    mc:Ignorable="d">
    <Window.Resources>
        <Style TargetType="ScrollBar" BasedOn="{StaticResource MaterialDesignScrollBarMinimal}">
            <Setter Property="materialDesign:ScrollBarAssist.ThumbWidth" Value="4" />
            <Setter Property="materialDesign:ScrollBarAssist.ThumbHeight" Value="4" />
            <Setter Property="materialDesign:ScrollBarAssist.ThumbCornerRadius" Value="2" />
        </Style>
        <Style TargetType="ScrollViewer" BasedOn="{StaticResource MaterialDesignScrollViewer}">
            <Setter Property="materialDesign:ScrollViewerAssist.ShowSeparators" Value="False" />
            <Setter Property="materialDesign:ScrollViewerAssist.CornerRectangleVisibility" Value="Collapsed" />
        </Style>
        <DataTemplate x:Key="SettingsNavigationHeader">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <materialDesign:PackIcon Kind="{DynamicResource SettingsNavigationIcon}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </DataTemplate>
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource SettingsPageForeground}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Border x:Name="NavigationItemBorder" CornerRadius="12" MinHeight="42" Margin="0,1"
                                    BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                <Grid>
                                    <Border x:Name="SelectionLayer" CornerRadius="12" IsHitTestVisible="False"
                                            Background="{DynamicResource MaterialDesign.Brush.Primary}" Opacity="0" />
                                    <Grid Margin="12,6,8,6">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                                        <ToggleButton x:Name="ExpandButton" Grid.Column="1" Focusable="False" Width="26" Height="28"
                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                            <materialDesign:PackIcon x:Name="ExpandIcon" Kind="ChevronRight" Width="18" Height="18" />
                                        </ToggleButton>
                                    </Grid>
                                </Grid>
                            </Border>
                            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" Margin="28,0,0,4" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False"><Setter TargetName="ExpandButton" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ExpandIcon" Property="Kind" Value="ChevronDown" />
                            </Trigger>
                            <Trigger SourceName="NavigationItemBorder" Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionLayer" Property="Opacity" Value="0.06" />
                                <Setter Property="Cursor" Value="Hand" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionLayer" Property="Opacity" Value="0.14" />
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="NavigationItemBorder" Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <materialDesign:DrawerHost x:Name="SettingsDrawer" OpenMode="Standard" IsLeftDrawerOpen="True">
        <materialDesign:DrawerHost.LeftDrawerContent>
            <Border Width="264" Padding="12,20,12,12" Background="{DynamicResource SettingsCardBackground}"
                    BorderBrush="{DynamicResource SettingsPageBorderBrush}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <Grid Margin="8,0,8,24">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource SettingsContainerBackground}" Margin="0,0,12,0">
                                <Image Source="/Resources/icc.ico" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static props:NavStrings.Nav_AppSettings}" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_ICCSettings}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SettingsPageAnnotationForeground}" />
                            </StackPanel>
                        </Grid>
                        <Border CornerRadius="14" Background="{DynamicResource SettingsContainerBackground}" Margin="4,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Kind="Magnify" Width="19" Height="19" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource SettingsPageAnnotationForeground}" />
                                <TextBox x:Name="controlsSearchBox" x:FieldModifier="public" Grid.Column="1"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource SettingsPageForeground}" Padding="0,12,12,12" FontSize="13"
                                         materialDesign:HintAssist.Hint="{x:Static props:NavStrings.Nav_SearchSettings}"
                                         TextChanged="OnControlsSearchBoxTextChanged" KeyDown="ControlsSearchBox_KeyDown" />
                            </Grid>
                        </Border>
                        <ListBox x:Name="SearchSuggestions" Visibility="Collapsed" MaxHeight="220" Margin="4,4,4,0"
                                 Background="{DynamicResource SettingsCardBackground}" SelectionChanged="SearchSuggestions_SelectionChanged" />
                    </StackPanel>
                    <TreeView x:Name="NavigationTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="NavigationTree_SelectedItemChanged">
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_Home}" Tag="HomePage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">HomeOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_General}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">Tune</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Startup}" Tag="StartupPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Clock}" Tag="ClockPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Settings_Nav_Security}" Tag="SecurityPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Advanced}" Tag="AdvancedPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_MainInterface}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">Monitor</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Window}" Tag="WindowPage" />
                            <TreeViewItem Header="{x:Static props:ThemeStrings.Theme_GroupTitle}" Tag="AppearancePage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Sidebar}" Tag="SidebarPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_Shortcuts}" Tag="HotkeyPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:CanvasStrings.Canvas_GroupTitle}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">Draw</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:CanvasStrings.Canvas_GroupTitle}" Tag="CanvasPage" />
                            <TreeViewItem Header="{x:Static props:CanvasStrings.InkRecog_Title}" Tag="InkRecognitionPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:PPTStrings.GroupTitle}" Tag="PowerPointPage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">PresentationPlay</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NotificationStrings.DefaultTitle}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">BellOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:NotificationStrings.SettingsTitle}" Tag="NotificationPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:AdvancedStrings.Experimental}" Tag="ExperimentalPage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">FlaskOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:StorageStrings.Storage_NavTitle}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">DatabaseOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:StorageStrings.Storage_Title}" Tag="StoragePage" />
                            <TreeViewItem Header="{x:Static props:StorageStrings.Backup_Title}" Tag="BackupPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_Toolbar}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">DockBottom</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_ToolbarComponents}" Tag="ToolbarPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_ToolbarAppearance}" Tag="ToolbarAppearancePage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_ToolbarMenu}" Tag="ToolbarMenuPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_Board}" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">ViewDashboardOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_BoardComponents}" Tag="BoardToolbarPage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_BoardAppearance}" Tag="BoardAppearancePage" />
                            <TreeViewItem Header="{x:Static props:NavStrings.Nav_BoardMenu}" Tag="BoardMenuPage" />
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:AutomationStrings.Automation_Title}" Tag="AutomationWorkflowPage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">AutoFix</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                        <TreeViewItem Header="Debug" Tag="DebugPage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">BugOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                        <TreeViewItem Header="{x:Static props:NavStrings.Nav_AboutInkCanvas}" Tag="AboutPage" HeaderTemplate="{StaticResource SettingsNavigationHeader}">
                            <TreeViewItem.Resources><materialDesign:PackIconKind x:Key="SettingsNavigationIcon">InformationOutline</materialDesign:PackIconKind></TreeViewItem.Resources>
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>
        </materialDesign:DrawerHost.LeftDrawerContent>
        <DockPanel>
            <Border DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource SettingsPageBorderBrush}" Background="{DynamicResource SettingsPageBackground}">
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Left" Margin="0,0,4,0"
                                  Style="{StaticResource MaterialDesignFlatToggleButton}" Width="40" Height="40" Padding="10"
                                  IsChecked="{Binding IsLeftDrawerOpen, ElementName=SettingsDrawer, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static props:NavStrings.Nav_AppSettings}">
                        <materialDesign:PackIcon Kind="Menu" Width="20" Height="20" />
                    </ToggleButton>
                    <Button DockPanel.Dock="Left" Margin="0,0,12,0" Width="40" Height="40" Padding="10"
                            Style="{StaticResource MaterialDesignIconButton}" Click="BackButton_Click"
                            IsEnabled="{Binding CanGoBack, ElementName=rootFrame}"
                            AutomationProperties.Name="{Binding Text, Source={x:Static NavigationCommands.BrowseBack}}">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20" />
                    </Button>
                    <TextBlock x:Name="AppTitleText" Text="{x:Static props:NavStrings.Nav_AppSettings}"
                               Foreground="{DynamicResource SettingsPageAnnotationForeground}"
                               VerticalAlignment="Center" FontSize="13" />
                </DockPanel>
            </Border>
            <Grid MaxWidth="1120" HorizontalAlignment="Stretch">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="24,24,24,2">
                    <TextBlock x:Name="PageHeader" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <Border Width="28" Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,10,0,0"
                            Background="{DynamicResource MaterialDesign.Brush.Primary}" />
                </StackPanel>
                <Frame x:Name="rootFrame" Grid.Row="1" Navigated="OnRootFrameNavigated" NavigationUIVisibility="Hidden"
                       Background="{DynamicResource SettingsPageBackground}" />
                <materialDesign:Snackbar x:Name="CopyUriSnackbar" Grid.RowSpan="2"
                                         VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" />
            </Grid>
        </DockPanel>
    </materialDesign:DrawerHost>
</Window>
