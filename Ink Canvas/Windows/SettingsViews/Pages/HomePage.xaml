<ui:Page xmlns:props="clr-namespace:Ink_Canvas.Properties"
         x:Class="Ink_Canvas.Windows.SettingsViews.Pages.HomePage"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
         xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
         xmlns:local="clr-namespace:Ink_Canvas.Windows.SettingsViews.Pages"
         xmlns:ui="http://schemas.inkore.net/lib/ui/wpf/modern"
         xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
         xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
         xmlns:sys="clr-namespace:System;assembly=mscorlib"
         mc:Ignorable="d"
         SizeChanged="HomePage_SizeChanged"
         Title="{x:Static props:HomeStrings.Home_Title}">

    <ui:Page.Resources>
        <Style TargetType="materialDesign:Card">
            <Setter Property="UniformCornerRadius" Value="16" />
            <Setter Property="materialDesign:ElevationAssist.Elevation" Value="Dp0" />
            <Setter Property="Background" Value="{DynamicResource SettingsCardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SettingsPageBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="HomeQuickLinkButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="16" />
        </Style>
    </ui:Page.Resources>

    <ScrollViewer PanningMode="VerticalFirst" VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource SettingsPageBackground}">
        <Grid x:Name="MainContentGrid" Margin="36,12,36,32" MaxWidth="1040">
            <ikw:SimpleStackPanel HorizontalAlignment="Stretch" Spacing="16">

                <!-- Hero / Header Card with MD3 Surface & Quick Actions -->
                <materialDesign:Card materialDesign:ElevationAssist.Elevation="Dp1">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- App Branding / Hero Title -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="50" Height="50" CornerRadius="16"
                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                    VerticalAlignment="Center" Margin="0,0,16,0">
                                <Image Source="\Resources\icc.ico" Width="28" Height="28"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static props:NavStrings.Nav_AppSettings}" TextWrapping="Wrap"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_Home_Tooltip}" TextWrapping="Wrap"
                                           FontSize="13" Margin="0,3,0,0"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
                            </StackPanel>
                        </Grid>

                        <!-- Quick Actions Section -->
                        <Border Grid.Row="1" Margin="0,0,0,16" Padding="12" CornerRadius="12"
                                Background="{DynamicResource SettingsContainerBackground}">
                            <ikw:SimpleStackPanel Spacing="8">
                                <TextBlock Text="{x:Static props:NotificationStrings.ActionsTitle}"
                                           FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                           Margin="4,0,0,2" />
                                <Grid x:Name="QuickActionsGrid">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="ActionsCol0" Width="*" />
                                        <ColumnDefinition x:Name="ActionsCol1" Width="*" />
                                        <ColumnDefinition x:Name="ActionsCol2" Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Restart Button -->
                                    <Button x:Name="BtnRestart" Grid.Column="0" Grid.Row="0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="BtnRestart_Click"
                                            Height="44" Padding="14,0" Margin="4"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            ToolTipService.ToolTip="{x:Static props:HomeStrings.Home_RestartApp}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Restart" Width="20" Height="20"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="{x:Static props:BtnStrings.Restart}"
                                                       FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Reset to Suggestions Button -->
                                    <Button x:Name="BtnReset" Grid.Column="1" Grid.Row="0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="BtnResetToSuggestion_Click"
                                            Height="44" Padding="14,0" Margin="4"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            ToolTipService.ToolTip="{x:Static props:HomeStrings.Home_ResetSettings}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="BackupRestore" Width="20" Height="20"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="{x:Static props:HomeStrings.Home_Reset}"
                                                       FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Exit Button -->
                                    <Button x:Name="BtnExit" Grid.Column="2" Grid.Row="0"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="BtnExit_Click"
                                            Height="44" Padding="14,0" Margin="4"
                                            materialDesign:ButtonAssist.CornerRadius="10"
                                            ToolTipService.ToolTip="{x:Static props:HomeStrings.Home_ExitApp}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0"
                                                                     Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                            <TextBlock Text="{x:Static props:FloatingBarStrings.OldUI_Exit}"
                                                       FontWeight="Medium" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </ikw:SimpleStackPanel>
                        </Border>

                        <!-- Quick Navigation Links (Chips) -->
                        <ikw:SimpleStackPanel Grid.Row="2" Spacing="8">
                            <TextBlock Text="{x:Static props:HomeStrings.Home_Title}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                                       Margin="4,0,0,0" />
                            <WrapPanel Orientation="Horizontal" Margin="-3">
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="StartupPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PlayOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:StartupStrings.Start}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="AppearancePage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PaletteOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:ThemeStrings.Theme_GroupTitle}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="CanvasPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Drawing" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:CanvasStrings.Canvas_GroupTitle}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="PowerPointPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="PresentationPlay" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:PPTStrings.GroupTitle}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="ToolbarPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ToolboxOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:NavStrings.Nav_Toolbar}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="BoardToolbarPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Whiteboard" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:NavStrings.Nav_Board}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="HotkeyPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="KeyboardOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:NavStrings.Nav_Shortcuts}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="NotificationPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BellOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:NotificationStrings.DefaultTitle}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="StoragePage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:StorageStrings.Storage_Title}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource HomeQuickLinkButton}"
                                        Click="QuickNavCard_Click" Tag="AboutPage">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="InformationOutline" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="{x:Static props:AboutStrings.Title}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </ikw:SimpleStackPanel>
                    </Grid>
                </materialDesign:Card>

                <!-- 1. General & Basic -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Tune" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_General}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:StartupStrings.Start}" Description="{x:Static props:NavStrings.Nav_Startup_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StartupPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="PlayOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Clock}" Description="{x:Static props:HomeStrings.Home_ClockSettings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ClockPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="ClockOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Settings_Nav_Security}" Description="{x:Static props:NavStrings.Settings_Nav_Security_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="SecurityPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Advanced}" Description="{x:Static props:NavStrings.Nav_Advanced_Settings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AdvancedPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 2. Main Interface & Personalization -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_MainInterface}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Window}" Description="{x:Static props:NavStrings.Nav_Window_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="WindowPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="WindowRestore" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:ThemeStrings.Theme_GroupTitle}" Description="{x:Static props:NavStrings.Nav_Theme_Settings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AppearancePage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Sidebar}" Description="{x:Static props:NavStrings.Nav_Sidebar_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="SidebarPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_Shortcuts}" Description="{x:Static props:NavStrings.Settings_Nav_Hotkey_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="HotkeyPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="KeyboardOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 3. Floating Toolbar -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="ToolboxOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_Toolbar}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarComponents}" Description="{x:Static props:NavStrings.Nav_ToolbarComponents_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="Rename" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarAppearance}" Description="{x:Static props:NavStrings.Nav_ToolbarAppearance_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarAppearancePage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_ToolbarMenu}" Description="{x:Static props:NavStrings.Nav_ToolbarMenu_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="ToolbarMenuPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 4. Canvas & Inking -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Drawing" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:CanvasStrings.Canvas_GroupTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:CanvasStrings.Canvas_GroupTitle}" Description="{x:Static props:HomeStrings.Home_CanvasSettings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="CanvasPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="Drawing" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:CanvasStrings.InkRecog_Title}" Description="{x:Static props:HomeStrings.Home_InkRecognitionSettings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="InkRecognitionPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="DrawPen" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 5. Whiteboard -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="Whiteboard" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:NavStrings.Nav_Board}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardComponents}" Description="{x:Static props:NavStrings.Nav_BoardComponents_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardToolbarPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="Rename" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardAppearance}" Description="{x:Static props:NavStrings.Nav_BoardAppearance_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardAppearancePage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="PaletteOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NavStrings.Nav_BoardMenu}" Description="{x:Static props:NavStrings.Nav_BoardMenu_Tooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="BoardMenuPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="FormatListBulleted" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 6. Integration & Services (PPT, Notifications, Automation) -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="PresentationPlay" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:PPTStrings.GroupTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:PPTStrings.GroupTitle}" Description="{x:Static props:HomeStrings.Home_PPTSettings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="PowerPointPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="PresentationPlay" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:NotificationStrings.DefaultTitle}" Description="{x:Static props:NotificationStrings.NavTooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="NotificationPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                            <ui:SettingsCard Header="{x:Static props:AutomationStrings.Automation_Title}" Description="{x:Static props:NavStrings.Nav_Automation_Settings}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="AutomationWorkflowPage">
                                <ui:SettingsCard.HeaderIcon>
                                    <materialDesign:PackIcon Kind="AutoFix" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" />
                                </ui:SettingsCard.HeaderIcon>
                            </ui:SettingsCard>
                        </ikw:SimpleStackPanel>
                    </StackPanel>
                </materialDesign:Card>

                <!-- 7. Storage & Maintenance -->
                <materialDesign:Card>
                    <StackPanel>
                        <Border Padding="16,12" Background="{DynamicResource SettingsContainerBackground}" CornerRadius="13,13,0,0">
                            <ikw:SimpleStackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="DatabaseOutline" Width="18" Height="18" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Static props:StorageStrings.Storage_NavTitle}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}" VerticalAlignment="Center" />
                            </ikw:SimpleStackPanel>
                        </Border>
                        <ikw:SimpleStackPanel Margin="8" Spacing="4">
                            <ui:SettingsCard Header="{x:Static props:StorageStrings.Storage_Title}" Description="{x:Static props:StorageStrings.Storage_NavTooltip}"
                                             IsClickEnabled="True" Click="QuickNavCard_Click" Tag="StoragePage">
                                <ui:SettingsCard.HeaderIcon>
