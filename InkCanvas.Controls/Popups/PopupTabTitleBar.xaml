<UserControl x:Class="Ink_Canvas.Controls.PopupTabTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ikw="http://schemas.inkore.net/lib/ui/wpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" d:Width="300">
    <Border Background="{DynamicResource FloatingBarPopupInnerBackgroundBrush}"
            CornerRadius="20,20,0,0" Padding="12,6,10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ikw:SimpleStackPanel x:Name="TabsPanel" Grid.Column="0"
                                  Orientation="Horizontal" VerticalAlignment="Center"
                                  Spacing="4" />
            <Button x:Name="CloseButton" Grid.Column="1"
                    Style="{DynamicResource MaterialDesignIconButton}"
                    Cursor="Hand" VerticalAlignment="Center"
                    Width="40" Height="40" MinWidth="40" MinHeight="40"
                    Padding="0" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="{Binding Text, Source={x:Static SystemCommands.CloseWindowCommand}}">
                <materialDesign:PackIcon Kind="Close"
                                         Foreground="{DynamicResource FloatingBarPopupTitleForegroundBrush}"
                                         Width="16" Height="16" />
            </Button>
        </Grid>
    </Border>
</UserControl>
